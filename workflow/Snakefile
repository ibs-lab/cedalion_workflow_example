rule blockaverage:
    input:
        input_snirf = expand(
            DERIV_ROOT / "preprocess/sub-{subject}/ses-{{session}}/nirs/sub-{subject}_ses-{{session}}_task-{{task}}_nirs.snirf",
            subject=config["dataset"]["subjects"],
        ),
    output:
        output_snirf = DERIV_ROOT / "analysis/ses-{session}/nirs/ses-{session}_task-{task}_blockaverage.snirf",
    params:
        func="cedalion.sigproc.steps:blockaverage",
        config=config["blockaverage"]
    script:
        "scripts/run_step.py"



rule analyze:
    input:
         BLOCKAVERAGE_SNIRF
    output:
        output_overview = report(
            ANALYSIS_OVERVIEW,
            category="Analysis",
            labels={"metric" : "Blockaveraged HRFs"}
        )
    log:
        # optional path to the processed notebook
        notebook="logs/notebooks/analyze_blockaverage.ipynb"
    notebook:
        "notebooks/analyze_blockaverage.ipynb"

