    subject=config["dataset"]["subjects"],
    session=config["dataset"]["sessions"],
    task=config["dataset"]["tasks"]
)

IMAGE_PARCEL_AVERAGE = expand(
    DERIV_ROOT / "image_recon/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_image_parcel_average.nc",
    subject=config["dataset"]["subjects"],
    session=config["dataset"]["sessions"],
    task=config["dataset"]["tasks"]
