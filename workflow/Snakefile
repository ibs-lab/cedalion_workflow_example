from pathlib import Path

configfile: "config/config.yaml"

wildcard_constraints:
    subject=r"[A-Za-z0-9_-]+",
    session=r"[A-Za-z0-9_-]+",
    task=r"[A-Za-z0-9_-]+",

ROOT_DIR = Path(config["dataset"]["root_dir"]).resolve()
DERIV_ROOT = Path(config["dataset"]["derivatives_dir"]).resolve()

HEAD_MODEL_CONFIG = config["sensitivity"]["head_model"]
CUSTOM_HEAD_MODEL = isinstance(HEAD_MODEL_CONFIG, dict)


def resolve_head_model_config(value, wildcards):
    """Resolve subject/session/task placeholders in custom head-model config."""
    if isinstance(value, str):
        return value.format(
            subject=wildcards.subject,
            session=wildcards.session,
            task=wildcards.task,
        )
    if isinstance(value, dict):
        return {
            key: resolve_head_model_config(item, wildcards)
            for key, item in value.items()
        }
    if isinstance(value, list):
        return [
            resolve_head_model_config(item, wildcards)
            for item in value
        ]
    return value


def sensitivity_step_config(wildcards):
    cfg = dict(config["sensitivity"])
    if CUSTOM_HEAD_MODEL:
        cfg["head_model"] = resolve_head_model_config(
            HEAD_MODEL_CONFIG,
            wildcards,
        )
    return cfg


def image_visualization_step_config(wildcards):
    cfg = dict(config["image_visualization"])
    if CUSTOM_HEAD_MODEL:
        cfg["head_model"] = resolve_head_model_config(
            HEAD_MODEL_CONFIG,
            wildcards,
        )
    return cfg


def image_reconstruction_step_config(wildcards):
    cfg = dict(config["image_reconstruction"])
    sbf_cfg = cfg.get("spatial_basis_functions")

    if CUSTOM_HEAD_MODEL and isinstance(sbf_cfg, dict):
        sbf_cfg = dict(sbf_cfg)
        sbf_cfg["head_model"] = resolve_head_model_config(
            HEAD_MODEL_CONFIG,
            wildcards,
        )
        cfg["spatial_basis_functions"] = sbf_cfg

    return cfg


if CUSTOM_HEAD_MODEL:
    SENSITIVITY_INPUT = (
        DERIV_ROOT
        / "preprocess/sub-{subject}/ses-{session}/nirs/"
        / "sub-{subject}_ses-{session}_task-{task}_nirs.snirf"
