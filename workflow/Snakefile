from pathlib import Path

configfile: "config/config.yaml"

wildcard_constraints:
    subject=r"[A-Za-z0-9_-]+",
    session=r"[A-Za-z0-9_-]+",
    task=r"[A-Za-z0-9_-]+",

ROOT_DIR = Path(config["dataset"]["root_dir"]).resolve()
DERIV_ROOT = Path(config["dataset"]["derivatives_dir"]).resolve()

PREPROCESSED_SNIRF = expand(
    DERIV_ROOT / "preprocess/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_nirs.snirf",
    subject=config["dataset"]["subjects"],
    session=config["dataset"]["sessions"],
    task=config["dataset"]["tasks"]
)

BLOCKAVERAGE_SNIRF = expand(
    DERIV_ROOT / "analysis/ses-{session}/nirs/ses-{session}_task-{task}_blockaverage.snirf",
