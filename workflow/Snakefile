from pathlib import Path

configfile: "config/config.yaml"

wildcard_constraints:
    subject=r"[A-Za-z0-9_-]+",
    session=r"[A-Za-z0-9_-]+",
    task=r"[A-Za-z0-9_-]+",

ROOT_DIR = Path(config["dataset"]["root_dir"]).resolve()
DERIV_ROOT = Path(config["dataset"]["derivatives_dir"]).resolve()

HEAD_MODEL = config["head_model"]
STANDARD_HEAD_MODEL = HEAD_MODEL in ("colin27", "icbm152")

# A head model manifest is a file. As a named rule input, Snakemake fills in its
# {subject}, {session} and {task} placeholders and tracks it. Standard head models
# are passed by name as a parameter. run_step.py merges both into the step arguments.
HEAD_MODEL_INPUT = {} if STANDARD_HEAD_MODEL else {"head_model": HEAD_MODEL}
HEAD_MODEL_PARAM = {"head_model": HEAD_MODEL} if STANDARD_HEAD_MODEL else {}

REGISTERED_OPTODES = (
    DERIV_ROOT
    / "preprocess/sub-{subject}/ses-{session}/nirs/"
    / "sub-{subject}_ses-{session}_task-{task}_optodes.tsv"
)

# An unscaled standard head model is the same for all recordings. Its sensitivity
# matrix is computed once with the probe of the first recording and shared.
SHARED_SENSITIVITY = (
    STANDARD_HEAD_MODEL and config["register_probe"].get("scale_to") is None
)

if SHARED_SENSITIVITY:
    SENSITIVITY_OPTODES = str(REGISTERED_OPTODES).format(
        subject=config["dataset"]["subjects"][0],
        session=config["dataset"]["sessions"][0],
        task=config["dataset"]["tasks"][0],
    )
    SENSITIVITY_FLUENCE = DERIV_ROOT / f"image_recon/shared/{HEAD_MODEL}_fluence.h5"
    SENSITIVITY_ADOT = DERIV_ROOT / f"image_recon/shared/{HEAD_MODEL}_sensitivity.h5"
else:
    SENSITIVITY_OPTODES = REGISTERED_OPTODES
    SENSITIVITY_FLUENCE = (
        DERIV_ROOT
        / "image_recon/sub-{subject}/ses-{session}/nirs/"
        / "sub-{subject}_ses-{session}_task-{task}_fluence.h5"
    )
    SENSITIVITY_ADOT = (
        DERIV_ROOT
        / "image_recon/sub-{subject}/ses-{session}/nirs/"
        / "sub-{subject}_ses-{session}_task-{task}_sensitivity.h5"
    )

PREPROCESSED_SNIRF = expand(
    DERIV_ROOT / "preprocess/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_nirs.snirf",
    subject=config["dataset"]["subjects"],
    session=config["dataset"]["sessions"],
    task=config["dataset"]["tasks"]
)

BLOCKAVERAGE_SNIRF = expand(
    DERIV_ROOT / "analysis/ses-{session}/nirs/ses-{session}_task-{task}_blockaverage.snirf",
    session=config["dataset"]["sessions"],
    task=config["dataset"]["tasks"]
)

IMAGE_RECON = expand(
    DERIV_ROOT / "image_recon/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_image.nc",
    subject=config["dataset"]["subjects"],
    session=config["dataset"]["sessions"],
    task=config["dataset"]["tasks"]
)

IMAGE_FEATURE = expand(
    DERIV_ROOT / "image_recon/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_image_feature.nc",
    subject=config["dataset"]["subjects"],
    session=config["dataset"]["sessions"],
    task=config["dataset"]["tasks"]
)

IMAGE_STATISTICS = expand(
    DERIV_ROOT / "image_recon/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_image_statistics.nc",
    subject=config["dataset"]["subjects"],
    session=config["dataset"]["sessions"],
    task=config["dataset"]["tasks"]
)


IMAGE_VISUALIZATION = expand(
    DERIV_ROOT / "image_recon/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_image_statistics.png",
    subject=config["dataset"]["subjects"],
    session=config["dataset"]["sessions"],
    task=config["dataset"]["tasks"]
)

IMAGE_BLOCKAVERAGE = expand(
    DERIV_ROOT / "image_recon/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_image_blockaverage.nc",
    subject=config["dataset"]["subjects"],
    session=config["dataset"]["sessions"],
    task=config["dataset"]["tasks"]
)

IMAGE_PARCEL_AVERAGE = expand(
    DERIV_ROOT / "image_recon/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_image_parcel_average.nc",
    subject=config["dataset"]["subjects"],
    session=config["dataset"]["sessions"],
    task=config["dataset"]["tasks"]
)

IMAGE_GROUP_AVERAGE = expand(
    DERIV_ROOT / "image_recon/group/ses-{session}/nirs/ses-{session}_task-{task}_image_group_average.nc",
    session=config["dataset"]["sessions"],
    task=config["dataset"]["tasks"]
)

IMAGE_GROUP_AVERAGE_VISUALIZATION = expand(
    DERIV_ROOT / "image_recon/group/ses-{session}/nirs/ses-{session}_task-{task}_image_group_average.png",
    session=config["dataset"]["sessions"],
    task=config["dataset"]["tasks"]
)

ANALYSIS_OVERVIEW = DERIV_ROOT / "analysis/preprocess_overview.png"

rule all:
    input:
        preprocessed_snirf = PREPROCESSED_SNIRF,
        dqr = expand(
            DERIV_ROOT / "preprocess/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_dqr.png", 
            subject=config["dataset"]["subjects"], 
            session=config["dataset"]["sessions"], 
            task=config["dataset"]["tasks"]
        ),
        dqrgvtdhist = expand(
            DERIV_ROOT / "preprocess/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_dqrgvtdhist.png", 
            subject=config["dataset"]["subjects"], 
            session=config["dataset"]["sessions"], 
            task=config["dataset"]["tasks"]
        ),
        dqrquality = expand(
            DERIV_ROOT / "preprocess/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_dqrquality.png", 
            subject=config["dataset"]["subjects"], 
            session=config["dataset"]["sessions"], 
            task=config["dataset"]["tasks"]
        ),
        blockaverage = BLOCKAVERAGE_SNIRF,
        image_reconstruction = IMAGE_RECON,
        image_feature = IMAGE_FEATURE,
        image_statistics = IMAGE_STATISTICS,
        image_visualization = IMAGE_VISUALIZATION,
        image_blockaverage = IMAGE_BLOCKAVERAGE,
        image_parcel_average = IMAGE_PARCEL_AVERAGE,
        image_group_average = IMAGE_GROUP_AVERAGE,
        image_group_average_visualization = IMAGE_GROUP_AVERAGE_VISUALIZATION,
        analysis_overview = ANALYSIS_OVERVIEW


checkpoint download_dataset:
    output:
        directory(ROOT_DIR)
    params:
        url="http://doc.ibs.tu-berlin.de/cedalion/datasets/dev/Fresh_Motor.zip"
    shell:
        """
        wget -O dataset.zip {params.url}
        unzip dataset.zip -d tmp_extract
        mv tmp_extract/*/ {output}
        rmdir tmp_extract
        rm dataset.zip
        """

def raw_data_files(wc):
    """Locate the raw data files of a single run in the downloaded dataset.

    The download_dataset checkpoint produces a directory. Snakemake tracks only the
    directory itself, not the files inside it. Requesting the checkpoint here
    establishes the dependency, so that a missing dataset gets downloaded.
    """
    root = Path(checkpoints.download_dataset.get().output[0])

    prefix = root / f"sub-{wc.subject}/ses-{wc.session}/nirs"
    
    return {
        "input_snirf": prefix / f"sub-{wc.subject}_ses-{wc.session}_task-{wc.task}_nirs.snirf",
        "input_events": prefix / f"sub-{wc.subject}_ses-{wc.session}_task-{wc.task}_events.tsv",
        "input_optodes": prefix / f"sub-{wc.subject}_ses-{wc.session}_optodes.tsv",
        "input_coordsystem": prefix / f"sub-{wc.subject}_ses-{wc.session}_coordsystem.json",
    }


rule preprocess:
    input:
        unpack(raw_data_files),
    output:
        output_snirf = DERIV_ROOT / "preprocess/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_nirs.snirf",
        output_sidecar = DERIV_ROOT / "preprocess/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_sidecar.nc"
    params:
        func="cedalion.sigproc.steps:preprocess",
        config=config["preprocess"]
    script:
        "scripts/run_step.py"


rule dqr:
    input:
        input_snirf = rules.preprocess.output.output_snirf,
        input_sidecar = rules.preprocess.output.output_sidecar
    output:
        output_dqr = report(
            DERIV_ROOT / "preprocess/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_dqr.png", 
            category="sub-{subject}", 
            subcategory="ses-{session}",
            labels={"metric" : "DQR overview"}
        ),
        output_gvtd_histogram = report(
            DERIV_ROOT / "preprocess/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_dqrgvtdhist.png",
            category="sub-{subject}", 
            subcategory="ses-{session}",
            labels={"metric" : "GVTD Histogram"}
        ),
        output_channel_quality = report(
            DERIV_ROOT / "preprocess/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_dqrquality.png",
            category="sub-{subject}", 
            subcategory="ses-{session}",
            labels={"metric" : "Channel Quality"}
        )
    params:
        func="cedalion.vis.dqr:generate_dqr_plots",
        config={}
    script:
        "scripts/run_step.py"


rule register_probe:
    input:
        input_snirf = rules.preprocess.output.output_snirf,
        **HEAD_MODEL_INPUT,
    output:
        output_optodes = REGISTERED_OPTODES,
    params:
        func="cedalion.dot.steps:register_probe",
        config=config["register_probe"] | HEAD_MODEL_PARAM
    script:
        "scripts/run_step.py"


rule sensitivity:
    input:
        input_optodes = SENSITIVITY_OPTODES,
        **HEAD_MODEL_INPUT,
    output:
        output_fluence = SENSITIVITY_FLUENCE,
        output_sensitivity = SENSITIVITY_ADOT
    params:
        func="cedalion.dot.steps:sensitivity",
        config=config["sensitivity"] | HEAD_MODEL_PARAM
    script:
        "scripts/run_step.py"


rule image_reconstruction:
    input:
        input_snirf = rules.preprocess.output.output_snirf,
        input_sensitivity = rules.sensitivity.output.output_sensitivity,
        # the probe registration from which the sensitivity matrix was computed
        input_optodes = SENSITIVITY_OPTODES,
        **HEAD_MODEL_INPUT,
    output:
        output_image = DERIV_ROOT / "image_recon/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_image.nc"
    params:
        func="cedalion.dot.steps:image_reconstruction",
        config=config["image_reconstruction"] | HEAD_MODEL_PARAM
    script:
        "scripts/run_step.py"


rule image_feature:
    input:
        input_image = rules.image_reconstruction.output.output_image,
        input_snirf = rules.preprocess.output.output_snirf
    output:
        output_feature = DERIV_ROOT / "image_recon/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_image_feature.nc"
    params:
        func="cedalion.dot.steps:image_feature",
        config=config["image_feature"]
    script:
        "scripts/run_step.py"


rule image_statistics:
    input:
        input_feature = rules.image_feature.output.output_feature
    output:
        output_statistics = DERIV_ROOT / "image_recon/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_image_statistics.nc"
    params:
        func="cedalion.dot.steps:image_statistics",
        config=config["image_statistics"]
    script:
        "scripts/run_step.py"


rule image_visualization:
    input:
        input_statistics = rules.image_statistics.output.output_statistics,
        input_image = rules.image_reconstruction.output.output_image,
        **HEAD_MODEL_INPUT,
    output:
        output_figure = report(
            DERIV_ROOT / "image_recon/sub-{subject}/ses-{session}/nirs/sub-{subject}_ses-{session}_task-{task}_image_statistics.png",
            category="sub-{subject}",
            subcategory="ses-{session}",
            labels={"metric": "DOT image statistics"},
        )
    params:
        func="cedalion.dot.steps:image_visualization",
        config=config["image_visualization"] | HEAD_MODEL_PARAM
    script:
        "scripts/run_step.py"


